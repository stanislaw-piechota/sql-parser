    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "DbStorage",
            "request": "launch",
            "mainClass": "com.example.sql.db.DbStorage",
            "projectName": "sql-parser"
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "App",
            "request": "launch",
            "mainClass": "com.example.App",
            "projectName": "sql-parser",
            "args": [
                "db.json"
            ]
        }
    ]
}